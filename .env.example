# Mashil 프런트엔드 환경 변수 템플릿.
# 이 파일을 `.env.local` 로 복사한 뒤 실제 키를 채워 넣으세요.
# `.env.local` 은 `.gitignore` 에 의해 절대 커밋되지 않습니다.

# Kakao Maps JavaScript SDK 앱 키 (https://developers.kakao.com 에서 발급)
# "JavaScript 키" 를 사용. REST API 키와 다릅니다.
VITE_KAKAO_MAP_KEY=your_kakao_javascript_key

# (선택) Supabase 미사용 빌드라면 비워둬도 됨 — 코드 어디서도 참조되지 않습니다.
# VITE_SUPABASE_URL=https://xxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key

# (선택) 개발 서버 설정 — 비워두면 기본값 사용
# VITE_API_PROXY_TARGET=http://localhost:5099   # 마실 백엔드(Mashil.Api) 가 떠 있는 주소
# VITE_DEV_PORT=5173                            # vite dev 서버 포트
